@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

# ═══════════════════════════════════════════════════════════════════════
# Ontology documentation shapes (opt-in): comments, domains, ranges, concept schemes.
#
# Not applied by default. These ask for documentation, so on a large imported ontology they
# produce a long list of sh:Info findings. Domain and range are a style choice: many ontologies
# (BFO-based ones among them) deliberately leave them out and use restrictions instead.
# Enable with the "Ontology Documentation" preset in Settings → SHACL, or ?shaclShapes= with
# ontology-quality.shacl.ttl,ontology-documentation.shacl.ttl.
# ═══════════════════════════════════════════════════════════════════════

<urn:shacl:ontology-documentation:ClassComment>
  a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select "SELECT ?this WHERE { ?this a <http://www.w3.org/2002/07/owl#Class> . FILTER(isIRI(?this)) }" ;
  ] ;
  sh:property [
    sh:path [ sh:alternativePath ( rdfs:comment skos:definition obo:IAO_0000115 ) ] ;
    sh:minCount 1 ;
    sh:severity sh:Info ;
    sh:message "OWL class should have a definition (rdfs:comment, skos:definition or obo:IAO_0000115)" ;
  ] .

<urn:shacl:ontology-documentation:ObjectPropertyDomain>
  a sh:NodeShape ;
  sh:targetClass owl:ObjectProperty ;
  sh:property [
    sh:path rdfs:domain ;
    sh:minCount 1 ;
    sh:severity sh:Info ;
    sh:message "Object property should declare rdfs:domain" ;
  ] .

<urn:shacl:ontology-documentation:ObjectPropertyRange>
  a sh:NodeShape ;
  sh:targetClass owl:ObjectProperty ;
  sh:property [
    sh:path rdfs:range ;
    sh:minCount 1 ;
    sh:severity sh:Info ;
    sh:message "Object property should declare rdfs:range" ;
  ] .

<urn:shacl:ontology-documentation:ConceptInScheme>
  a sh:NodeShape ;
  sh:targetClass skos:Concept ;
  sh:property [
    sh:path skos:inScheme ;
    sh:minCount 1 ;
    sh:severity sh:Info ;
    sh:message "SKOS concept should be in a concept scheme (skos:inScheme)" ;
  ] .

<urn:shacl:ontology-documentation:LabelLanguage>
  a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select "SELECT ?this WHERE { { ?this a <http://www.w3.org/2002/07/owl#Class> } UNION { ?this a <http://www.w3.org/2002/07/owl#ObjectProperty> } UNION { ?this a <http://www.w3.org/2002/07/owl#DatatypeProperty> } FILTER(isIRI(?this)) }" ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    sh:datatype rdf:langString ;
    sh:severity sh:Info ;
    sh:message "Label should have a language tag (e.g. \"name\"@en)" ;
  ] .

# A class with no superclass, subclass, equivalent class, domain or range is not connected to the
# rest. One SPARQL target selects them; sh:not [ sh:nodeKind sh:IRI ] reports each selected node.
<urn:shacl:ontology-documentation:OrphanClass>
  a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select """
      SELECT ?this WHERE {
        ?this a <http://www.w3.org/2002/07/owl#Class> .
        FILTER(isIRI(?this) && ?this != <http://www.w3.org/2002/07/owl#Thing>)
        FILTER NOT EXISTS { ?this <http://www.w3.org/2000/01/rdf-schema#subClassOf> ?a . FILTER(?a != <http://www.w3.org/2002/07/owl#Thing>) }
        FILTER NOT EXISTS { ?b <http://www.w3.org/2000/01/rdf-schema#subClassOf> ?this }
        FILTER NOT EXISTS { ?this <http://www.w3.org/2002/07/owl#equivalentClass> ?c }
        FILTER NOT EXISTS { ?d <http://www.w3.org/2002/07/owl#equivalentClass> ?this }
        FILTER NOT EXISTS { ?p <http://www.w3.org/2000/01/rdf-schema#domain> ?this }
        FILTER NOT EXISTS { ?r <http://www.w3.org/2000/01/rdf-schema#range> ?this }
      }""" ;
  ] ;
  sh:severity sh:Info ;
  sh:message "Class is not connected: no superclass, subclass, equivalent class, domain or range" ;
  sh:not [ sh:nodeKind sh:IRI ] .
