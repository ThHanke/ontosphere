@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

# ═══════════════════════════════════════════════════════════════════════
# Ontology quality shapes (default): every entity needs a label.
#
# These are the checks that apply to nearly every ontology, so they are the built-in default.
# Documentation checks (comment, domain, range, inScheme) are in ontology-documentation.shacl.ttl.
#
# Accepted labels: rdfs:label, skos:prefLabel or dcterms:title (SKOS concepts: skos:prefLabel or
# rdfs:label). A shape that should skip anonymous nodes (restrictions, unions) uses a SPARQL
# target with FILTER(isIRI(?this)); sh:targetClass alone also targets blank nodes.
# ═══════════════════════════════════════════════════════════════════════

# ── owl:Class (named classes only: blank-node owl:Class are anonymous class expressions) ──
<urn:shacl:ontology-quality:ClassLabel>
  a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select "SELECT ?this WHERE { ?this a <http://www.w3.org/2002/07/owl#Class> . FILTER(isIRI(?this)) }" ;
  ] ;
  sh:property [
    sh:path [ sh:alternativePath ( rdfs:label skos:prefLabel dcterms:title ) ] ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "OWL class should have a label (rdfs:label, skos:prefLabel or dcterms:title)" ;
  ] .

# ── owl:ObjectProperty / owl:DatatypeProperty ────────────────────────

<urn:shacl:ontology-quality:ObjectPropertyLabel>
  a sh:NodeShape ;
  sh:targetClass owl:ObjectProperty ;
  sh:property [
    sh:path [ sh:alternativePath ( rdfs:label skos:prefLabel dcterms:title ) ] ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "Object property should have a label (rdfs:label, skos:prefLabel or dcterms:title)" ;
  ] .

<urn:shacl:ontology-quality:DatatypePropertyLabel>
  a sh:NodeShape ;
  sh:targetClass owl:DatatypeProperty ;
  sh:property [
    sh:path [ sh:alternativePath ( rdfs:label skos:prefLabel dcterms:title ) ] ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "Datatype property should have a label (rdfs:label, skos:prefLabel or dcterms:title)" ;
  ] .

# ── SKOS ─────────────────────────────────────────────────────────────

<urn:shacl:ontology-quality:ConceptPrefLabel>
  a sh:NodeShape ;
  sh:targetClass skos:Concept ;
  sh:property [
    sh:path [ sh:alternativePath ( skos:prefLabel rdfs:label ) ] ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "SKOS concept should have a label (skos:prefLabel preferred)" ;
  ] .

<urn:shacl:ontology-quality:ConceptSchemeLabel>
  a sh:NodeShape ;
  sh:targetClass skos:ConceptScheme ;
  sh:property [
    sh:path [ sh:alternativePath ( rdfs:label skos:prefLabel dcterms:title ) ] ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "SKOS concept scheme should have a label (rdfs:label, skos:prefLabel or dcterms:title)" ;
  ] .
