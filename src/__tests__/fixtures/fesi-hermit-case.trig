    skos:definition "process of taking up corpuscular radiation by a material entity"@en;
    <urn:vg:loadedFrom> <https://ontosphere.test/eval-fixtures/3b98aad/pmdco.ttl>.
pmd:PMD_0000802 rdfs:subClassOf obo:BFO_0000015;
