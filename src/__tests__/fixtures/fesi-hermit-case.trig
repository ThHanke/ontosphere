pmd:PMD_0000849 rdfs:subClassOf obo:OBI_0000070, _:4935d333;
    a owl:Class;
    rdfs:label "Mechanische Eigenschaften Analyseverfahren"@de, "mechanical property analyzing process"@en;
    skos:definition "An assay that evaluates the mechanical characteristics of materials, such as strength, hardness, elasticity, and tensile properties, often through tests that measure response to forces and loads."@en, "Eine Analyse, die die mechanischen Eigenschaften von Materialien bewertet, wie z.B. Festigkeit, Härte, Elastizität und Zugfestigkeit, oft durch Tests, die die Reaktion auf Kräfte und Lasten messen."@de;
    <urn:vg:loadedFrom> <https://ontosphere.test/eval-fixtures/3b98aad/pmdco.ttl>.
