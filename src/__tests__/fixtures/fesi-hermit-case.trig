pmd:PMD_0000552 rdfs:subClassOf pmd:PMD_0000957, _:4887689c;
    a owl:Class;
    rdfs:label "Analyseverfahren für die chemische Zusammensetzung"@de, "chemical composition analyzing process"@en;
