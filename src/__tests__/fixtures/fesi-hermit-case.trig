pmd:PMD_0000817 rdfs:subClassOf _:c995ab39;
    a owl:Class;
    rdfs:label "Laserschneider"@de, "lasercutter"@en;
    skos:definition "A device that utilizes laser beams to create precise cuts in various materials such as wood, plastic, metal, etc."@en, "Ein Gerät, das Laserstrahlen verwendet, um präzise Schnitte in verschiedenen Materialien wie Holz, Kunststoff, Metall usw. zu erzeugen."@de;
    <urn:vg:loadedFrom> <https://ontosphere.test/eval-fixtures/3b98aad/pmdco.ttl>.
