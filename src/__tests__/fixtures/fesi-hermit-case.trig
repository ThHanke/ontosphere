pmd:PMD_0000584 rdfs:subClassOf pmd:PMD_0000833;
    a owl:Class;
    rdfs:label "Konditionierungsprozess"@de, "conditioning process"@en;
    skos:definition "A conditioning process is a manufacturing process that sets a material entity to predefined environmental conditions."@en, "Diese Aktivität beschreibt den Prozess und die Maßnahmen, die ergriffen werden, um einen materiellen Gegenstand auf vordefinierte Umgebungsbedingungen einzustellen."@de;
    <urn:vg:loadedFrom> <https://ontosphere.test/eval-fixtures/3b98aad/pmdco.ttl>.
pmd:PMD_0000585 rdfs:subClassOf pmd:PMD_0000931;
    a owl:Class;
    rdfs:label "continuous simulation"@en;
    skos:definition "A simulation method specification where changes in a system are modeled continuously over time."@en;
    pmd:PMD_0000060 true;
    <urn:vg:loadedFrom> <https://ontosphere.test/eval-fixtures/3b98aad/pmdco.ttl>.
pmd:PMD_0000931 rdfs:subClassOf obo:IAO_0000104;
    a owl:Class;
    rdfs:label "simulation method specification"@en;
    skos:definition "A plan specification that specifies the method of creating a computational or physical model to replicate the behavior of a material or system under specific conditions."@en;
    pmd:PMD_0000060 true;
    <urn:vg:loadedFrom> <https://ontosphere.test/eval-fixtures/3b98aad/pmdco.ttl>.
