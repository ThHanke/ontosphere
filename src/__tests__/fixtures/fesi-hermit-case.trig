    a owl:Class;
    rdfs:label "Optische Eigenschaften Analyseverfahren"@de, "optical property analyzing process"@en;
    skos:definition "An assay that assesses the optical characteristics of materials, such as refractive index, absorption, transmission, reflectivity, and luminescence."@en, "Eine Analyse, die die optischen Eigenschaften von Materialien bewertet, wie z.B. Brechungsindex, Absorption, Transmission, Reflexion und Lumineszenz."@de;
    <urn:vg:loadedFrom> <https://ontosphere.test/eval-fixtures/3b98aad/pmdco.ttl>.
