    a owl:Class;
    rdfs:label "Temperaturmessfunktion"@de, "temperature measuring function"@en;
    skos:definition "A measuring function performed to determine the temperature of an object or environment."@en, "Eine Messefunktion, die durchgeführt wird, um die Temperatur eines Objekts oder einer Umgebung zu bestimmen."@de;
